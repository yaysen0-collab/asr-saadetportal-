---
import SiteLayout from '../layouts/SiteLayout.astro';
import faq from '../data/faq.json';
const title = 'Sahabeler ve Asr-ı Saadet Hakkında Sorular';
const description = 'Sahabeler, Asr-ı Saadet dönemi, siyer kaynakları ve portalın kullanımı hakkında sık sorulan soruların yanıtlarını okuyun.';
const canonical = 'https://asrisaadetportali.vercel.app/faq';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---
<SiteLayout page="faq" {title} {description} {canonical} {jsonLd}>
  <main class="person-page">
    <nav class="person-crumbs" aria-label="breadcrumb"><a href="/">Ana Sayfa</a> › Sıkça Sorulan Sorular</nav>
    <h1>Sıkça Sorulan Sorular</h1>
    <p class="lead">Portalın kapsamı, kaynakları ve kullanımı hakkında yanıtlar.</p>
    <div class="faq-list">
      {faq.map(([question, answer]) => <details class="faq-item"><summary class="faq-question">{question}</summary><div class="faq-answer">{answer}</div></details>)}
    </div>
  </main>
</SiteLayout>

